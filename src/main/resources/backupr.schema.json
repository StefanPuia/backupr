{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "remotes",
    "sources"
  ],
  "properties": {
    "variables": {
      "type": "object",
      "description": "A set of <String, String> key-value pairs that can be reused in the configuration. These variables can reference each other, but only in the order they are defined."
    },
    "credentials": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/credentials"
          },
          {
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "remotes": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "properties": {
              "name": {
                "$ref": "#/definitions/identifier"
              }
            },
            "required": [
              "name"
            ]
          },
          {
            "$ref": "#/definitions/remote"
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/definitions/abstractSource"
              },
              {
                "properties": {
                  "type": {
                    "const": "LOCAL"
                  },
                  "directory": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Base directory of the sources. Supports templating."
                  },
                  "files": {
                    "type": "array",
                    "description": "File patterns, relative to `directory`. Supports templating.",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[0-9a-zA-Z\\-_.]+$"
    },
    "remote": {
      "anyOf": [
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/definitions/abstractRemote"
            },
            {
              "properties": {
                "type": {
                  "const": "LOCAL"
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Base directory to be used for backup storage. Supports templating."
                }
              },
              "required": [
                "location"
              ]
            }
          ]
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/definitions/abstractRemote"
            },
            {
              "properties": {
                "type": {
                  "const": "AZURE_STORAGE_BLOB"
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Azure storage account endpoint. Supports templating."
                },
                "container": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the storage container. Supports templating."
                },
                "blobPrefixPattern": {
                  "type": "string",
                  "minLength": 1,
                  "default": "<context.sourceName>/<context.nowYear>/<context.nowMonth>/<context.nowDay>",
                  "description": "Pattern used to prefix the blob name. The original filename will be appended to this. Supports templating with context. Context includes: default context, sourceName (Name of current source), originalFilePath (Original path of file, relative to the source/transformer base path)"
                },
                "overwrite": {
                  "type": "boolean",
                  "default": false,
                  "description": "Overwrite any existing blob with the same name"
                }
              },
              "required": [
                "endpoint",
                "container"
              ]
            }
          ]
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/definitions/abstractRemoteWithCredentials"
            },
            {
              "properties": {
                "type": {
                  "const": "GIT"
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Git remote URL. Supports templating."
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Git branch name. Supports templating."
                }
              },
              "required": [
                "url",
                "branch"
              ]
            }
          ]
        }
      ]
    },
    "abstractRemote": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type"
      ]
    },
    "abstractRemoteWithCredentials": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/abstractRemote"
        },
        {
          "properties": {
            "credentials": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/definitions/credentials"
                }
              ]
            }
          }
        }
      ]
    },
    "abstractSource": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "remotes": {
          "type": "array",
          "description": "List of remotes where this source should be backed up to. These must reference existing remotes defined in this configuration.",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/definitions/remote"
              }
            ]
          }
        },
        "transformers": {
          "type": "array",
          "description": "List of transformers to be applied to the sources before being sent to the remotes.",
          "items": {
            "$ref": "#/definitions/transformer"
          }
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "credentials": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/abstractCredentials"
        },
        {
          "anyOf": [
            {
              "$ref": "#/definitions/noneCredentials"
            },
            {
              "$ref": "#/definitions/basicCredentials"
            }
          ]
        }
      ]
    },
    "abstractCredentials": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "noneCredentials": {},
    "basicCredentials": {
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "description": "Basic auth username. Supports templating."
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Basic auth password. Supports templating."
        }
      },
      "required": [
        "username"
      ]
    },
    "transformer": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ZIP",
            "TARGZ"
          ]
        },
        {
          "$ref": "#/definitions/zipTransformer"
        },
        {
          "$ref": "#/definitions/targzTransformer"
        }
      ]
    },
    "zipTransformer": {
      "type": "object",
      "properties": {
        "zip": {
          "type": "object",
          "properties": {
            "filenamePattern": {
              "type": "string",
              "default": "<context.sourceName>-<context.now>.zip",
              "description": "Pattern to be used as filename for the created zip file. Supports templating with context. Context includes: default context, sourceName (Name of current source)",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "zip"
      ]
    },
    "targzTransformer": {
      "type": "object",
      "properties": {
        "targz": {
          "type": "object",
          "properties": {
            "filenamePattern": {
              "type": "string",
              "default": "<context.sourceName>-<context.now>.tar.gz",
              "description": "Pattern to be used as filename for the created archive file. Supports templating with context. Context includes: default context, sourceName (Name of current source)",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "targz"
      ]
    }
  }
}
